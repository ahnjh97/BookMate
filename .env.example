# 환경변수
# cp .env.example -> .env

# ── DB 접속 정보 ──

# [로컬/XE 방식] 테스트하고 싶을 때는 3줄 주석 해제하고 아래 3줄 주석 처리
# DB_URL=jdbc:oracle:thin:@localhost:1521/xe # XEPDB1
# DB_USER=bookmate
# DB_PASSWORD=book

# [Docker/Free 방식 — 서버 기본값]
DB_URL=jdbc:oracle:thin:@localhost:1521/FREEPDB1
DB_USER=APP
DB_PASSWORD=oracle

# ── DB 컨테이너 환경변수 (Docker 전용) ──
ORACLE_PASSWORD=oracle
APP_USER=APP
APP_USER_PASSWORD=oracle
ORACLE_HOST_PORT=1521