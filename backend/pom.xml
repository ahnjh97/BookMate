<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>bookmate</groupId>
    <artifactId>backend</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>jar</packaging>
    
    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- exec-maven-plugin가 기본으로 실행할 클래스 이름 (기본값 Main(서버)) -->
        <!-- DB 초기화 스크립트(scripts/drop-volume.bat)에서
         -Dexec.mainClass=util.DBInit 로 이 값을 덮어써서 DBInit을 대신 실행
         <mainClass>Main</mainClass>이 고정값이라 커맨드라인 오버라이드가 무시되었음 -->
        <exec.mainClass>Main</exec.mainClass>
    </properties>
    <dependencies>
        <!-- jar 수동다운받을 필요 없이 mvn이 알아서 Maven Central 등록된 jdbc 로드-->
        <dependency>
            <groupId>com.oracle.database.jdbc</groupId>
            <artifactId>ojdbc17</artifactId>
            <version>23.26.3.0.0</version>
        </dependency>
        <!-- .env 파일 로더: Spring Profile + application.properties/application.yml 대용 -->
        <dependency>
            <groupId>io.github.cdimascio</groupId>
            <artifactId>dotenv-java</artifactId>
            <version>3.2.0</version>
        </dependency>
        <!-- HikariCP: DB 연결을 매번 새로 맺지 않고 재사용해서 성능 저하·연결 누수 방지 -->
        <dependency>
            <groupId>com.zaxxer</groupId>
            <artifactId>HikariCP</artifactId>
            <version>5.1.0</version>
        </dependency>
        <!-- HikariCP 로그 출력 구현체: StaticLoggerBinder 경고 방지 -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <version>1.7.36</version>
            <scope>runtime</scope>
        </dependency>
        <!-- Gson: Java 객체와 JSON 데이터 간 변환 -->
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>2.11.0</version>
        </dependency>

        <!-- Jakarta Servlet API: HTTP 요청·응답 및 세션 처리 -->
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <version>6.0.0</version>
            <scope>provided</scope>
        </dependency>
        <!-- Lombok: 컴파일 시 코드 생성에 사용 -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>1.18.42</version>
            <scope>provided</scope>
        </dependency>
        <!-- tomcat-embed-core: Tomcat 서버 자체를 라이브러리로 사용, 코드 안에서 직접 구동 -->
        <dependency>
            <groupId>org.apache.tomcat.embed</groupId>
            <artifactId>tomcat-embed-core</artifactId>
            <version>10.1.57</version>
        </dependency>
        <!-- tomcat-embed-jasper: JSP 지원용, 미사용이지만 초기화 안정성 위해 포함 -->
        <dependency>
            <groupId>org.apache.tomcat.embed</groupId>
            <artifactId>tomcat-embed-jasper</artifactId>
            <version>10.1.57</version>
        </dependency>
    </dependencies>

    <build>
        <finalName>bookmate</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>21</release>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <configuration>
                    <!-- 실행할 클래스: 위 exec.mainClass 값을 그대로 사용.
                        실행 시 -Dexec.mainClass=다른클래스명 을 붙이면 그 클래스가 대신 실행됨 -->
                    <mainClass>${exec.mainClass}</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
